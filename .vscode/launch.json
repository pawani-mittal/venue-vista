{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "🎭 Launch Venue Vista Server",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server.js",
      "runtimeArgs": ["--no-warnings"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Server live on: (http://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🧪 Run Automated Test Suite",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/tests/test-api.js",
      "runtimeArgs": ["--no-warnings"],
      "console": "integratedTerminal"
    }
  ]
}
